# Copier dans .env pour le développement. Définir ces variables dans Coolify en production.
NUXT_ADMIN_USERNAME=remi
NUXT_ADMIN_PASSWORD=
# Secret aléatoire d'au moins 32 caractères, distinct du mot de passe administrateur.
NUXT_SESSION_PASSWORD=
NUXT_SITE_URL=http://localhost:3000
NUXT_DATA_DIR=./data
